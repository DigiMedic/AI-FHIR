# Příklad konfiguračního souboru pro frontend AI-FHIR komponenty.
# Zkopírujte tento soubor do '.env' v tomto adresáři (frontend/.env)
# a upravte hodnoty podle vaší konfigurace.

# React aplikace načítají proměnné prostředí s prefixem REACT_APP_.
# Více informací: https://create-react-app.dev/docs/adding-custom-environment-variables/

# URL adresa backendového API serveru, na který se bude frontend připojovat.
# Měla by obsahovat pouze schéma, hostname a port (pokud je jiný než standardní).
# Např. http://localhost:8000 nebo https://vas-api-server.cz
# Cesta k API endpointům (např. /api/process_document) se přidává v kódu aplikace.
REACT_APP_API_URL=http://localhost:8000

# Příklad dalších možných proměnných pro frontend:
# REACT_APP_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
# REACT_APP_FEATURE_FLAG_XYZ_ENABLED=true
