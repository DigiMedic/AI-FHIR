# Příklad konfiguračního souboru pro backend AI-FHIR komponenty.
# Zkopírujte tento soubor do '.env' v tomto adresáři (backend/.env)
# a upravte hodnoty podle vaší konfigurace.

# Konfigurace pro DigiMedic API klienta
# Tyto proměnné jsou potřeba, pokud chcete odesílat FHIR Bundly na reálný DigiMedic FHIR server.
# Pokud nejsou nastaveny, DigiMedicAPIClient poběží v simulovaném režimu (viz dokumentace klienta).

# Základní URL adresa DigiMedic API serveru
# Příklad: DIGIMEDIC_API_BASE_URL=https://api.digimedic.cz/fhir
DIGIMEDIC_API_BASE_URL=

# Autorizační token pro přístup k DigiMedic API
# Příklad: DIGIMEDIC_API_TOKEN="VášSkutečnýTokenZde"
DIGIMEDIC_API_TOKEN=

# Další možné proměnné pro backend (pokud by byly potřeba):
# Například konfigurace databáze, externích služeb, atd.
# UVICORN_HOST=0.0.0.0
# UVICORN_PORT=8000
# LOG_LEVEL=info
